NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Lets `npm run db:setup` apply supabase/migrations without the SQL editor.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional alternative to the access token for db:setup. Also required by
# `npm run embeddings:listings` and by the portal, which re-embeds a site when
# staff save it, and by the 5-per-hour limit on re-embedding a person's
# answers. Without it, neither happens. Project Settings > API.
# Keep this out of anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If both are set, db:setup can turn on Google in Auth > Providers.
# Create an OAuth client in Google Cloud. Authorized redirect URI:
# https://your-project-ref.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Embeddings for shelter matching (server only, never NEXT_PUBLIC_).
# Create at https://platform.openai.com/api-keys
# Needed for: the "Find a place" survey to sync and rank (app/api/needs/embed),
# `npm run embeddings:listings` (real listings), and `npm run embeddings:eval`
# (the /dev/embedding-eval tool's synthetic data).
OPENAI_API_KEY=
# Optional. Default is text-embedding-3-small (1536 dimensions). A model with
# another dimension needs the vector(1536) columns in the migration changed.
EMBEDDING_MODEL=text-embedding-3-small

# Optional. Model that reads a typed sentence (app/api/deadlines/read) and a
# scanned photo (app/api/scan) on Financials. Must accept images. Uses
# OPENAI_API_KEY above. Without the key, people fill the boxes in by hand.
DEADLINE_MODEL=gpt-4.1-mini

# Speaking answers instead of typing them. Uses the SAME OPENAI_API_KEY above:
# Whisper is a different endpoint on the same account, so there is no new
# credential. It is billed per minute of audio rather than per token, so it is
# a separate line on the same bill. Without the key, the mic button says so and
# people type instead.
TRANSCRIBE_MODEL=whisper-1
